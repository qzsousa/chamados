# Application
NODE_ENV=production
PORT=10000

# Database (Supabase PostgreSQL)
# Formato Direct Connection (recomendado para Render):
# DATABASE_URL=postgresql://postgres:[SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public
#
# Formato Pooler (se precisar):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=public
DATABASE_URL=

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://seu-frontend.vercel.app

# Sentry (optional)
SENTRY_DSN=

# Supabase (for admin operations - service role key)
# Pegue em: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Google Sheets Migration (optional - for one-time migration)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=

# Logging
LOG_LEVEL=info