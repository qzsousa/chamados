# Application
NODE_ENV=production
PORT=10000

# Database (Supabase PostgreSQL)
# Runtime (transaction pooler, suporta IPv4/IPv6 no Render):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# Migrations (session pooler, suporta migrate deploy + IPv4):
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://seu-frontend.vercel.app

# Sentry (optional)
SENTRY_DSN=

# Supabase (for admin operations - service role key)
# Pegue em: Supabase Dashboard → Settings → API → service_role
# SUPABASE_URL=https://<project-ref>.supabase.co (opcional: deriva da service key quando ausente)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Sheets Migration (optional - for one-time migration)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Planilha principal (Usuarios, Equipamentos, Chamados)
GOOGLE_SHEETS_ID=
# Planilha de inventário (aba "Base de Dados": escola + status do inventário)
GOOGLE_INVENTARIO_SHEETS_ID=

# E-mail (notificações de chamado; se vazio, os e-mails são apenas logados e não enviados)
# Gmail (recomendado para começar): gere uma "Senha de aplicativo" em
#   https://myaccount.google.com/apppasswords  (requer Verificação em 2 etapas ativada)
#   e use-a em SMTP_PASS (sem espaços).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu.email@gmail.com
SMTP_PASS=senha-de-aplicativo-de-16-caracteres
EMAIL_FROM=seu.email@gmail.com

# Logging
LOG_LEVEL=info