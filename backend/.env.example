# Application
NODE_ENV=production
PORT=10000

# Database (Supabase PostgreSQL)
# Formato Direct Connection (recomendado para Render):
# DATABASE_URL=postgresql://postgres:[SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public
#
# Formato Pooler (se precisar):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=public
DATABASE_URL=postgresql://postgres:Tec2026lt3..@db.fbclxihtmdftohmdzdid.supabase.co:5432/postgres
# JWT Secrets (generate with: openssl rand -base64 32)
