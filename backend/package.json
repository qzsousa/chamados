{
  "name": "sci-chamados-backend",
  "version": "1.0.0",
  "description": "Backend API for sci-chamados - Render + Supabase",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "migration:run": "tsx src/services/migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shared/api": "file:../shared/types",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "googleapis": "^178.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "vitest": "^1.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "20.x"
  }
}