generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String   @id @default(cuid())
  email             String   @unique
  nome              String
  senhaHash         String
  nivel             String   // ADMIN, TECNICO, GESTOR, VISUALIZADOR
  filial            String
  status            String   @default("ATIVO") // ATIVO, INATIVO
  primeiroLogin     Boolean  @default(true)
  refreshTokenHash  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([filial])
  @@index([nivel])
  @@index([status])
}

model Escola {
  id               String   @id @default(cuid())
  nome             String   @unique
  nomeNormalizado  String   @unique
  tecnico          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventario       Inventario?

  @@index([tecnico])
}

model Chamado {
  id                 String   @id @default(cuid())
  protocolo          String   @unique
  timestamp          DateTime @default(now())
  unidade            String
  solicitante        String
  funcao             String?
  tipo               String
  descricao          String
  urgencia           String
  anexoUrl           String?
  status             String   @default("ABERTO") // ABERTO, ANDAMENTO, COMUNICADO, RESOLVIDO
  responsavel        String?
  ultimaAtualizacao  DateTime @updatedAt
  historico          String?
  tecnicoResolucao   String?
  descricaoResolucao String?
  tecnicoSetor       String?
  inventarioStatus   String?  // CONCLUIDO, EM_ANDAMENTO, NAO_REALIZADO, NAO_INFORMADO
  email              String?  // e-mail do solicitante
  excluido           Boolean  @default(false) // soft delete
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  avaliacao          Avaliacao?
  mensagens          ChamadoMensagem[]

  @@index([unidade])
  @@index([status])
  @@index([tecnicoSetor])
  @@index([timestamp])
  @@index([protocolo])
  @@index([responsavel])
}

model Inventario {
  id        String   @id @default(cuid())
  escolaId  String   @unique
  escola    Escola   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  status    String   // CONCLUIDO, EM_ANDAMENTO, NAO_REALIZADO, NAO_INFORMADO
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Equipamento {
  id         String   @id @default(cuid())
  categoria  String
  marca      String
  modelo     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoria, marca, modelo])
  @@index([categoria])
  @@index([categoria, marca])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

model Avaliacao {
  id         String   @id @default(cuid())
  chamadoId  String   @unique
  chamado    Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())
}

model Feedback {
  id       String   @id @default(cuid())
  tipo     String   // 'ELOGIO' | 'SUGESTAO'
  nome     String?
  unidade  String?
  mensagem String
  criadoEm DateTime @default(now())
}

model TutorialCategoria {
  id        String     @id @default(cuid())
  nome      String     @unique
  descricao String?
  cor       String?    // hex para chip colorido na UI, ex.: '#3b82f6'
  createdAt DateTime   @default(now())

  tutoriais Tutorial[]
}

model Tutorial {
  id            String            @id @default(cuid())
  titulo        String
  subtitulo     String?
  conteudo      String            // texto simples, quebras de linha preservadas na UI
  categoriaId   String
  categoria     TutorialCategoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  criadoPor     String            // nome do admin que criou
  visualizacoes Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  anexos        TutorialAnexo[]

  @@index([categoriaId])
  @@index([createdAt])
}

model TutorialAnexo {
  id         String   @id @default(cuid())
  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  url        String
}

// Perguntas da matriz (status "Aguardando escola") e respostas da escola.
// O texto é permanente; apenas os anexos são temporários (7 dias).
model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tipo      String   // PERGUNTA (matriz -> escola) | RESPOSTA (escola -> matriz)
  autorNome String
  texto     String
  createdAt DateTime @default(now())

  anexos    ChamadoMensagemAnexo[]

  @@index([chamadoId])
}

model ChamadoMensagemAnexo {
  id         String          @id @default(cuid())
  mensagemId String
  mensagem   ChamadoMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  url        String
  path       String          // path interno no bucket `anexos` (necessário para remoção)
  expiresAt  DateTime        // anexo temporário: removido do Storage + banco após 7 dias
  createdAt  DateTime        @default(now())

  @@index([mensagemId])
  @@index([expiresAt])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String?
  filial    String?
  tipo      String   // CHAMADO_NOVO | CHAMADO_RESPONDIDO | CHAMADO_FINALIZADO | ERRO_SISTEMA
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId, lida])
  @@index([filial])
}

// Formulário de abertura de chamados configurável (categorias + perguntas
// dinâmicas, com condicionais por resposta). Semeado a partir do formulário
// legado na primeira leitura pública.
model FormularioCategoria {
  id        String   @id @default(cuid())
  chave     String   @unique
  nome      String
  descricao String?
  cor       String?
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perguntas FormularioPergunta[]

  @@index([ativa, ordem])
}

model FormularioPergunta {
  id                  String              @id @default(cuid())
  categoriaId         String
  categoria           FormularioCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  rotulo              String
  ajuda               String?
  tipo                String              // OPCOES | TEXTO | TEXTO_LONGO
  obrigatoria         Boolean             @default(true)
  ordem               Int                 @default(0)
  ativa               Boolean             @default(true)
  dependeDePerguntaId String?
  dependeDeOpcao      String?
  opcoes              Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([categoriaId, ordem])
}