generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String   @id @default(cuid())
  email             String   @unique
  nome              String
  senhaHash         String
  nivel             String   // ADMIN, TECNICO, GESTOR, VISUALIZADOR
  filial            String
  status            String   @default("ATIVO") // ATIVO, INATIVO
  primeiroLogin     Boolean  @default(true)
  refreshTokenHash  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens     RefreshToken[]
  codigosAcesso     CodigoPrimeiroAcesso[]

  @@index([email])
  @@index([filial])
  @@index([nivel])
  @@index([status])
}

model Escola {
  id               String   @id @default(cuid())
  nome             String   @unique
  nomeNormalizado  String   @unique
  tecnico          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventario       Inventario?

  @@index([tecnico])
}

model Chamado {
  id                 String   @id @default(cuid())
  protocolo          String   @unique
  timestamp          DateTime @default(now())
  unidade            String
  solicitante        String
  funcao             String?
  tipo               String
  descricao          String
  urgencia           String
  anexoUrl           String?
  status             String   @default("ABERTO") // ABERTO, ENCAMINHADO, ANDAMENTO, COMUNICADO, AGUARDANDO_CONFERENCIA, RESOLVIDO
  responsavel        String?
  // Id do usuário responsável. `responsavel` continua sendo o NOME (é por ele
  // que os filtros e o histórico funcionam), mas notificar o técnico na
  // reabertura exige o id — sem ele só daria para avisar os admins.
  responsavelId      String?
  ultimaAtualizacao  DateTime @updatedAt
  historico          String?
  tecnicoResolucao   String?
  descricaoResolucao String?
  tecnicoSetor       String?
  inventarioStatus   String?  // CONCLUIDO, EM_ANDAMENTO, NAO_REALIZADO, NAO_INFORMADO
  email              String?  // e-mail do solicitante
  categoriaChave     String?  // chave da categoria do formulário público (ex.: 'equipamento')
  // Respostas do formulário dinâmico, como foram respondidas na abertura.
  // Vai como Json (lista de { perguntaId, rotulo, resposta }) e não como linhas
  // de tabela porque é um retrato do momento da abertura: se o ADMIN reescrever a
  // pergunta depois, o técnico tem de continuar vendo o texto que a escola leu.
  // NULL nos chamados abertos sem formulário (todo o histórico anterior).
  formularioRespostas Json?
  aceitoEm           DateTime? // quando o técnico aceitou o chamado (botão "Aceitar"). Gravado só na ida para ANDAMENTO a partir de ABERTO/ENCAMINHADO
  concluidoEm        DateTime? // técnico registrou a conclusão (AGUARDANDO_CONFERENCIA); a RESOLVIDO final vira `conferidoEm`
  excluido           Boolean  @default(false) // soft delete

  // ---- Marco do fluxo de atendimento ----
  // Quantas vezes a escola contestou e o chamado voltou para ABERTO.
  reaberturas        Int      @default(0)
  aceitoPor          String?
  conferidoEm        DateTime? // escola confirmou que ficou tudo certo
  conferidoPor       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  avaliacao          Avaliacao?
  mensagens          ChamadoMensagem[]
  atividades         ChamadoAtividade[]
  anexos             ChamadoAnexo[]

  @@index([unidade])
  @@index([status])
  @@index([tecnicoSetor])
  @@index([timestamp])
  @@index([protocolo])
  @@index([responsavel])
  @@index([responsavelId])
  @@index([categoriaChave])
}

/// Arquivos enviados na ABERTURA do chamado pelo formulário público.
///
/// Fica em tabela própria (e não no `Chamado.anexoUrl`, que é a coluna única que
/// o histórico trazia) porque o formulário pede VÁRIOS arquivos de uma vez — o
/// aviso de "solicitação de pontos de rede" exige foto de cada sala, e o do SEI
/// exige a imagem do erro. `anexoUrl` continua sendo gravado com o primeiro
/// arquivo para as telas antigas não mudarem de comportamento.
///
/// Diferente dos anexos da conversa, estes NÃO expiram: eles são parte da
/// descrição do problema e o técnico precisa deles enquanto atende.
model ChamadoAnexo {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  nome      String
  tipo      String?
  url       String
  path      String   // path interno no bucket `anexos` (necessário para remoção)
  criadoEm  DateTime @default(now())

  @@index([chamadoId])
}

/// Registro datado do atendimento: o que o técnico fez, a conclusão, a
/// contestação da escola e a aprovação final.
///
/// Fica em tabela própria (e não em `historico`, que é TEXTO) porque o técnico
/// registra várias vezes o mesmo chamado, cada registro precisa de data/hora
/// REAL — não inferida por regex — e porque os anexos deste registro são a
/// prova do serviço, então não expiram como os da conversa.
model ChamadoAtividade {
  id         String   @id @default(cuid())
  chamadoId  String
  chamado    Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  // REGISTRO | CONCLUSAO | CONTESTACAO | APROVACAO
  tipo       String
  autorNome  String
  autorNivel String?
  texto      String
  criadoEm   DateTime @default(now())

  anexos     ChamadoAtividadeAnexo[]

  @@index([chamadoId, criadoEm])
}

model ChamadoAtividadeAnexo {
  id          String          @id @default(cuid())
  atividadeId String
  atividade   ChamadoAtividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  nome        String
  tipo        String?
  url         String
  criadoEm    DateTime        @default(now())

  @@index([atividadeId])
}

// Regras de encaminhamento automático: chamado de uma categoria do formulário
// vai para o técnico da unidade (UNIDADE) ou para um técnico fixo (TECNICO).
model EncaminhamentoRegra {
  id             String   @id @default(cuid())
  categoriaChave String   @unique // ex.: 'equipamento'
  modo           String   @default("UNIDADE") // UNIDADE | TECNICO
  tecnicoId      String?  // obrigatório quando modo = TECNICO
  tecnicoNome    String?  // nome do técnico quando a regra foi configurada (exibição)
  ativa          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ativa])
}

model Inventario {
  id        String   @id @default(cuid())
  escolaId  String   @unique
  escola    Escola   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  status    String   // CONCLUIDO, EM_ANDAMENTO, NAO_REALIZADO, NAO_INFORMADO
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Equipamento {
  id         String   @id @default(cuid())
  categoria  String
  marca      String
  modelo     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoria, marca, modelo])
  @@index([categoria])
  @@index([categoria, marca])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Código de 6 dígitos enviado por e-mail para provar a posse da caixa postal
/// ANTES de a pessoa criar a senha no primeiro acesso.
///
/// Existe porque o SCE antigo aceitava `/definir-senha` só com o e-mail — quem
/// soubesse o endereço de um colega ainda sem senha tomava a conta. Aqui o
/// e-mail sozinho não abre nada: sem o código, a senha não é criada.
///
/// Só o SHA-256 do código é guardado (como o refreshToken); o de 6 dígitos nunca
/// toca o banco. `tentativas` trava o brute force offline do hash.
model CodigoPrimeiroAcesso {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  expiraEm   DateTime
  tentativas Int       @default(0)
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  codigosConfirmados CodigoConfirmado[]

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Comprovante de que o código foi conferido, liberando a criação da senha.
///
/// Existe para o `/definir-senha` não poder ser chamado "direto": ele exige um
/// token de uso único, válido por 10 minutos, emitido só depois que o código
/// bateu. Se o usuário pedir outro código no meio do caminho, este registro é
/// revogado — o token antigo deixa de valer.
model CodigoConfirmado {
  id                String   @id @default(cuid())
  codigoId          String
  codigo            CodigoPrimeiroAcesso @relation(fields: [codigoId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  expiraEm          DateTime
  revogadoEm        DateTime?
  criadoEm          DateTime @default(now())

  @@index([codigoId])
  @@index([expiraEm])
}

model Avaliacao {
  id         String   @id @default(cuid())
  chamadoId  String   @unique
  chamado    Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())
}

model Feedback {
  id       String   @id @default(cuid())
  tipo     String   // 'ELOGIO' | 'SUGESTAO'
  nome     String?
  unidade  String?
  mensagem String
  criadoEm DateTime @default(now())
}

model TutorialCategoria {
  id        String     @id @default(cuid())
  nome      String     @unique
  descricao String?
  cor       String?    // hex para chip colorido na UI, ex.: '#3b82f6'
  createdAt DateTime   @default(now())

  tutoriais Tutorial[]
}

model Tutorial {
  id            String            @id @default(cuid())
  titulo        String
  subtitulo     String?
  conteudo      String            // texto simples, quebras de linha preservadas na UI
  categoriaId   String
  categoria     TutorialCategoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  criadoPor     String            // nome do admin que criou
  visualizacoes Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  anexos        TutorialAnexo[]

  @@index([categoriaId])
  @@index([createdAt])
}

model TutorialAnexo {
  id         String   @id @default(cuid())
  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  url        String
}

// Perguntas da matriz (status "Aguardando escola") e respostas da escola.
// O texto é permanente; apenas os anexos são temporários (7 dias).
model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tipo      String   // PERGUNTA (matriz -> escola) | RESPOSTA (escola -> matriz)
  autorNome String
  texto     String
  createdAt DateTime @default(now())

  anexos    ChamadoMensagemAnexo[]

  @@index([chamadoId])
}

model ChamadoMensagemAnexo {
  id         String          @id @default(cuid())
  mensagemId String
  mensagem   ChamadoMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  url        String
  path       String          // path interno no bucket `anexos` (necessário para remoção)
  expiresAt  DateTime        // anexo temporário: removido do Storage + banco após 7 dias
  createdAt  DateTime        @default(now())

  @@index([mensagemId])
  @@index([expiresAt])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String?
  filial    String?
  tipo      String   // CHAMADO_NOVO | CHAMADO_RESPONDIDO | CHAMADO_FINALIZADO | ERRO_SISTEMA
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId, lida])
  @@index([filial])
}

// Formulário de abertura de chamados configurável (categorias + perguntas
// dinâmicas, com condicionais por resposta). Semeado a partir do formulário
// legado na primeira leitura pública.
model FormularioCategoria {
  id        String   @id @default(cuid())
  chave     String   @unique
  nome      String
  descricao String?
  cor       String?
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perguntas FormularioPergunta[]

  @@index([ativa, ordem])
}

model FormularioPergunta {
  id                  String              @id @default(cuid())
  categoriaId         String
  categoria           FormularioCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  rotulo              String
  ajuda               String?
  tipo                String              // OPCOES | TEXTO | TEXTO_LONGO
  obrigatoria         Boolean             @default(true)
  ordem               Int                 @default(0)
  ativa               Boolean             @default(true)
  dependeDePerguntaId String?
  dependeDeOpcao      String?
  opcoes              Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([categoriaId, ordem])
}