# Segredos do sci-chamados-api -> Google Secret Manager.
#
#   cp secrets.example.env secrets.env
#   (preencha os valores, depois:)
#   ./deploy-cloudrun.ps1 -SecretsFile deploy/secrets.env
#
# O script cria um secret por linha, com o nome `chamados-<chave em kebab-case>`
# (ex.: a linha DATABASE_URL vira o secret chamados-database-url) e injeta no
# servico via --set-secrets. Os valores NUNCA vao para o git nem para o
# Artifact Registry.
#
# ----- OBRIGATORIAS (sem estas o processo morre no boot) --------------------
# Pegue o pooler em Supabase > Project Settings > Database > Connection string.
# Atencao: a URL do pooler (porta 5432) e a direta (porta 5432, host db.*) sao
# campos diferentes; DIRECT_URL aponta para o host direto.
DATABASE_URL=
DIRECT_URL=

# minimo de 32 caracteres cada (exigencia do zod em src/config/env.ts).
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# service_role do projeto Supabase.
SUPABASE_SERVICE_KEY=

# Conteudo do JSON da conta de servico do Google, em UMA LINHA, sem quebra:
#   {"type":"service_account","project_id":"..."}
# No PowerShell, para ler o arquivo e juntar em uma linha:
#   (Get-Content backend/gcp-service-account.json -Raw) -replace '\s+',''
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----- OPCIONAIS -----------------------------------------------------------
# SMTP do gov.br. Se nao houver, o sistema usa o Brevo.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Chave da API do Brevo (e-mail instantaneo, sem problema de IPv6).
BREVO_API_KEY=

# Segredo compartilhado com o SCE para o SSO. Precisa ser IDENTICO ao
# SSO_SECRET do backend do SCE.
SCE_SYNC_KEY=

# DSN do Sentry. Deixe vazio para nao reportar.
SENTRY_DSN=
